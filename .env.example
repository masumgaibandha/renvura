# Copy to .env.local and fill in. Never commit .env.local.

# --- Public -----------------------------------------------------------------
# Origin used for canonical URLs, hreflang, Open Graph and the sitemap.
# Must be the real origin per environment — a wrong value poisons canonicals.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Server -----------------------------------------------------------------
# Atlas development cluster. Required by `npm run db:check` and by
# POST /api/contact — but NOT by `npm run build`.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=renvura_dev

# Email notification for contact enquiries.
# `log` writes the notification to the server log instead of sending it. It is
# the only adapter implemented in Phase 1 — enquiries are always persisted to
# MongoDB first, so nothing is lost while no provider is configured.
EMAIL_PROVIDER=log
CONTACT_EMAIL_TO=hello@renvura.com

# --- Development only -------------------------------------------------------
# Enables synthetic demo products (D-08). Demo records must live in a SEPARATE
# development database — point MONGODB_DB_NAME at one before enabling this, never
# at the production cluster. Hard-blocked on the real production site regardless
# of this value, and a runtime guard throws if it is ever set there.
# DEMO_MODE=1

# Renders not-yet-built navigation controls (Shop, Search, Cart, …) as visibly
# DISABLED placeholders so the header's final proportions can be reviewed before
# those routes exist. This is §11.1.1 option 2 and is hard-blocked on the real
# production site regardless of this value. Leave unset everywhere else.
# NAV_PREVIEW=1
